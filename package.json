{
  "name": "pocket-ledger",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/core.test.mjs tests/planning.test.mjs",
    "test:ui": "node tests/ui.mjs && node tests/update-ui.mjs && node tests/planning-ui.mjs",
    "test:scale": "node --test --test-concurrency=1 tests/scalability.test.mjs tests/capacity-browser.test.mjs",
    "test:storage": "node --test tests/workspace.test.mjs"
  },
  "dependencies": {
    "clawpdf": "0.3.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "playwright": "1.58.2"
  }
}
